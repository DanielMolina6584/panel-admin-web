{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*serviceAccount*.json)",
      "Read(./**/*firebase-adminsdk*.json)",
      "Read(~/**)",
      "Read(//etc/**)",
      "Edit(./.env*)",
      "Edit(../**)",
      "Write(./.env*)",
      "Write(../**)",
      "Bash(cat .env*)",
      "Bash(* .env*)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(git push*)",
      "Bash(vercel*)",
      "Bash(firebase deploy*)",
      "Bash(npm publish*)"
    ],
    "ask": ["Bash(curl*)", "Bash(wget*)", "Bash(npm install*)", "Bash(npm i *)", "Bash(git commit*)"],
    "allow": ["Bash(npm run verificar)", "Bash(npm run lint)", "Bash(npm test*)", "Bash(npx tsc --noEmit)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "npm run -s lint" }]
      }
    ]
  }
}
